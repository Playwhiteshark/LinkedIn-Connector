{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkedin-connector",
  "main": "src/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      // OAuth grants/tokens (props encrypted by workers-oauth-provider) and short-lived login state.
      "binding": "OAUTH_KV",
      "id": "5986d5de7cbc4559aa30649945016778"
    }
  ],
  "secrets": {
    "required": ["LINKEDIN_CLIENT_ID", "LINKEDIN_CLIENT_SECRET"]
  },
  "vars": {
    // LinkedIn REST API version (YYYYMM). Versions are supported for about a year; bump when LinkedIn sunsets it.
    "LINKEDIN_API_VERSION": "202610"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
